# .env.example を .env にコピーして値を書き込んでください(.env は Git に入りません)
# Stripe ダッシュボード → 開発者 → API キー(テストモード)の Secret key
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
# 決済後の戻り先。ローカルならこのままで OK
BASE_URL=http://localhost:3000
# Webhook の署名シークレット (whsec_...)。ローカルでは `stripe listen` が表示する値
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
